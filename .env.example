NODE_ENV=development
PORT=3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:3000

# Integração Google Drive (opcional; o portal funciona sem ela, somente com metadados)
# Pasta de destino dos arquivos, por exemplo 1EyOr4vYGl16cgbfx9e7y_XQjduJRtrhQ
GOOGLE_DRIVE_FOLDER_ID=
# Modo de autorização: oauth (conta do usuário) ou service_account (conta de serviço)
GOOGLE_DRIVE_AUTH_MODE=oauth
# Modo oauth: usados pelo fluxo “Conectar Google Drive” e para renovar o acesso
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Modo service_account: alternativa sem fluxo de consentimento
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Opcionais
# GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/drive.metadata.readonly
# GOOGLE_DRIVE_MAX_UPLOAD_BYTES=26214400
